---
import BaseLayout from '../layouts/BaseLayout.astro';

const githubUrl = 'https://github.com/patr-cloud/patr';
---

<BaseLayout title="Page not found" description="This page didn't deploy.">
  <section class="notfound">
    <div class="glow" aria-hidden="true"></div>
    <p class="code">404</p>
    <h1>Nothing shipped here.</h1>
    <p class="sub">
      Either the link rotted or I fat-fingered a URL — happens to the best of us.
      Or I broke something — I'm willing to bet on it. No page at this address
      either way; here's the way back.
    </p>
    <div class="cta-row">
      <a class="btn btn-primary" href="/">Home</a>
      <a class="btn" href="/blog">Blog</a>
      <a class="btn" href={githubUrl}>GitHub</a>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    position: relative;
    text-align: center;
    padding: 4rem 0 3rem;
  }
  .glow {
    position: absolute;
    top: -8%;
    left: 50%;
    transform: translateX(-50%);
    width: min(560px, 90%);
    height: 300px;
    background: radial-gradient(ellipse at center, var(--color-accent-glow), transparent 70%);
    filter: blur(20px);
    pointer-events: none;
    z-index: -1;
  }
  .code {
    font-family: var(--font-mono);
    font-size: clamp(4rem, 16vw, 7rem);
    font-weight: 700;
    line-height: 1;
    margin: 0;
    color: var(--color-accent);
    letter-spacing: -0.03em;
  }
  h1 {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 1rem 0 1rem;
  }
  .sub {
    color: var(--color-muted);
    max-width: 34em;
    margin: 0 auto 2rem;
  }
  .cta-row {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-block;
    padding: 0.65rem 1.6rem;
    border: 1px solid var(--color-accent);
    border-radius: 8px;
    color: var(--color-accent);
    font-weight: 600;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .btn:hover {
    transform: translateY(-2px);
    opacity: 1;
    box-shadow: 0 6px 20px -6px var(--color-accent-glow);
  }
  .btn:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  .btn-primary { background: var(--color-accent); color: var(--color-bg); }
  .btn-primary:hover { box-shadow: 0 8px 26px -6px rgba(248, 155, 65, 0.5); }
</style>
